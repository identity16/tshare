# Development template only. Inject actual values through private secret storage.
# No paid resources or TLS certificates are created by this package.
TSHARE_TEAM_ORIGIN=https://team.example.com
GOOGLE_CLIENT_ID=replace-with-a-dedicated-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-a-private-client-secret
CSRF_SECRET=replace-with-at-least-32-random-bytes-and-keep-stable-across-instances
RUNTIME_DATABASE_URL=postgresql://tshare_runtime:replace@database.example.com/tshare?sslmode=verify-full
HOST=127.0.0.1
PORT=8792
# Operator commands only; do not give these to the HTTP process:
# MIGRATION_DATABASE_URL=postgresql://migration_owner:replace@database.example.com/tshare?sslmode=verify-full
# TSHARE_RUNTIME_ROLE=tshare_runtime
# TSHARE_OWNER_EMAIL=owner@example.com
# TSHARE_OWNER_SUBJECT=subject-from-an-independently-verified-Google-ID-token
# TSHARE_ORGANIZATION_NAME=Example team
